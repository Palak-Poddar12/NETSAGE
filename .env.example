# NetSage AI Backend Environment Configuration
APP_NAME=NetSage AI Backend
DEBUG=True

# SQLite database file (path is relative to the backend/ folder)
DATABASE_URL=sqlite:///./netsage.db

# Optional: OpenAI API key for LLM-powered diagnosis.
# If empty, the built-in deterministic fallback synthesis is used (works fully offline).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Allowed CORS origins (frontend URLs). Accepts a JSON array or comma-separated list.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development server defaults (used by scripts/start-backend)
HOST=127.0.0.1
PORT=8000
